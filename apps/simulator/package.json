{
  "name": "@herdpulse/simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts stream",
    "demo": "tsx src/index.ts demo",
    "incident:duplicate": "tsx src/index.ts duplicate",
    "incident:schema": "tsx src/index.ts schema-break",
    "replay:dlq": "tsx src/index.ts replay-dlq",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@herdpulse/event-contracts": "workspace:*",
    "dotenv": "^17.2.3",
    "kafkajs": "^2.2.4",
    "ulid": "^3.0.1"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
