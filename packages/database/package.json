{
  "name": "@herdpulse/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@herdpulse/domain": "workspace:*",
    "dotenv": "^17.2.3",
    "kysely": "^0.28.8",
    "pg": "^8.16.3",
    "ulid": "^3.0.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6"
  }
}
